# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

[*.md]
indent_size = unset
max_line_length = 200

[*.lean]
indent_size = 2

# The axioms tripwire quotes Lean's `#print axioms` output verbatim inside
# `#guard_msgs` docstrings; those lines cannot be wrapped.
[lean/HydrozoanTest/Axioms.lean]
max_line_length = unset

# The formalization's README carries wide tables (result → claim).
[lean/README.md]
max_line_length = unset

[{*.yml,*.yaml,*.toml}]
indent_size = 2
max_line_length = 150

[**/assets/banner.txt]
indent_size = unset
indent_style = unset
trim_trailing_whitespace = false
max_line_length = unset

# Ignore paths
[{.git/**/*,.claude/**/*,**/*.lock,LICENSE,**/grafana-dashboard.json,lean/lake-manifest.json}]
charset = unset
end_of_line = unset
indent_size = unset
indent_style = unset
insert_final_newline = unset
max_line_length = unset
trim_trailing_whitespace = unset
